# Use a NEW .env for this project, not SquareDriveConnector's .env.
# Leave blank to use %LOCALAPPDATA%/ShotScopeConnector on Windows.
SHOTSCOPE_DATA_DIR=
SHOTSCOPE_EMAIL=
# Must already exist in your actual Drive for desktop folder.
# Example only: G:/My Drive/Golf Performance/ShotScope
SHOTSCOPE_OUTPUT_DIR=
# Keep unknown until provider distance units have been verified on a real round.
SHOTSCOPE_DISTANCE_UNIT=unknown
# No passwords or upload tokens here. Run `shotscope login` locally on Windows.
